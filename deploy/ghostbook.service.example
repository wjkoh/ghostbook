[Unit]
Description=Ghostbook Collaborative Book Authoring Studio
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ghostbook
Group=ghostbook
UMask=0077
WorkingDirectory=/var/lib/ghostbook/data
EnvironmentFile=-/etc/ghostbook/env
# To enable loopback profiling during diagnostics, add: --pprof-addr=127.0.0.1:6060
ExecStart=/usr/local/bin/ghostbook \
  --addr=127.0.0.1:8090 \
  --data-dir=/var/lib/ghostbook/data \
  --base-url=https://book.example.com \
  --book-title="Engineering Handbook" \
  --book-kicker="Living Book" \
  --mcp-name="engineering-handbook" \
  --authors-file=/etc/ghostbook/authors.json \
  --allowed-hosts=book.example.com \
  --sync-interval=60s
Restart=always
RestartSec=3
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ghostbook/data
CapabilityBoundingSet=
RestrictSUIDSGID=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
